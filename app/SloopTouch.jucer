  <JUCEOPTIONS JUCE_USE_ANDROID_OBOE="1"/>
  <EXPORTFORMATS>
    <ANDROIDSTUDIO targetFolder="Builds/Android" androidMinimumSDK="26" androidTargetSDK="34"
                   androidEnableContentSharing="1" androidBluetoothScanNeeded="1"
                   androidBluetoothConnectNeeded="1"
                   androidOtherPermissions="android.permission.ACCESS_WIFI_STATE android.permission.ACCESS_NETWORK_STATE"
                   androidScreenOrientation="unspecified"
                   extraCompilerFlags="-fwrapv -fno-strict-aliasing">
      <CONFIGURATIONS>
        <CONFIGURATION isDebug="1" name="Debug" optimisation="1"
