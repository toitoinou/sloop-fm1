<?xml version="1.0" encoding="UTF-8"?>

<!-- SLOOP Touch for Android (Projucer -> Builds/Android, an Android Studio / Gradle project).
     JUCE is expected in app/JUCE (a checkout of JUCE 8.0.4, not in the repository), the engine's generated tables
     in engine/gen (tools/gen_engine_tables.sh), Ableton Link and Signalsmith Stretch in third_party
     (tools/get_deps.sh). The CI does all three: .github/workflows/app.yml. The header paths are relative to the exporter folder, Builds/Android
     (Projucer moves them one level for its app/CMakeLists.txt) -->
<JUCERPROJECT id="Sl00pT" name="SloopTouch" projectType="guiapp" version="0.1.0" companyName="SLOOP"
              bundleIdentifier="org.sloop.touch" cppLanguageStandard="17" jucerFormatVersion="1"
              displaySplashScreen="0" reportAppUsage="0"
              defines="JUCE_WEB_BROWSER=0&#10;JUCE_USE_CURL=0&#10;JUCE_USE_MP3AUDIOFORMAT=1&#10;LINK_PLATFORM_LINUX=1&#10;ASIO_STANDALONE=1&#10;ASIO_NO_TYPEID=1&#10;ASIO_VERSION_NAMESPACE=sloop_link_asio">
  <MAINGROUP id="Gr00p0" name="SloopTouch">
